# Django
# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# REQUIRED in production — never '*'
ALLOWED_HOSTS=portfolio-api.onrender.com

# Admin lives at this path instead of /admin/ (scanner noise reduction)
ADMIN_URL=dashboard

# Database
# Prefer DATABASE_URL (Render provides it automatically):
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_ENGINE=django.db.backends.postgresql
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS — exact frontend origin(s) only
CORS_ALLOWED_ORIGINS=https://portfolio-frontend.onrender.com

# Deployment / TLS
SECURE_SSL_REDIRECT=True

# Rate limiting (see portfolio/throttling.py):
# THROTTLE_USE_XFF=on  # ONLY when the origin is behind exactly one trusted proxy (Render)

# Two-factor auth — how long the browser remembers you
# TWO_FACTOR_REMEMBER_COOKIE_AGE=3600

# Email — forwards contact-form messages to the owner
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=you@example.com
CONTACT_EMAIL=you@example.com

# Optional: bootstrap a superuser on first seed, then REMOVE these two lines
# ADMIN_USERNAME=Mr.Skm
# ADMIN_PASSWORD=change-me-immediately
